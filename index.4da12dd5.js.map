"use strict";
var thumbs = document.querySelector("#thumbs");
thumbs.addEventListener("click", function(e) {
    var link = e.target.closest(".list-item__link");
    if (!link) return;
    e.preventDefault();
    var largeImg = document.getElementById("largeImg");
    largeImg.src = link.href;
});

